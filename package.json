{
    "name": "@loadscript/harness",
    "version": "1.0.2",
    "description": "Reusable browser client for the underload harness server.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./frontend": {
            "types": "./src/frontend/index.ts",
            "default": "./src/frontend/index.ts"
        },
        "./frontend/*": {
            "types": "./src/frontend/*.ts",
            "default": "./src/frontend/*.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/__snapshots__/**",
        "!src/frontend/dist/**",
        "!src/**/node_modules/**",
        "!src/**/.vite/**"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/loadscript/harness.git"
    },
    "homepage": "https://github.com/loadscript/harness#readme",
    "bugs": {
        "url": "https://github.com/loadscript/harness/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "vite build --config src/frontend/vite.config.ts",
        "build:frontend": "vite build --config src/frontend/vite.config.ts",
        "dev": "vite --config src/frontend/vite.config.ts",
        "dev:frontend": "vite --config src/frontend/vite.config.ts",
        "preview:frontend": "vite preview --config src/frontend/vite.config.ts",
        "test": "vitest run --config src/frontend/vitest.config.ts",
        "test:frontend": "vitest run --config src/frontend/vitest.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "author": "NQQT",
    "license": "ISC",
    "dependencies": {
        "@underload/harness": "*",
        "dompurify": "^3.4.15",
        "highlight.js": "11.12.0",
        "marked": "^18.0.12"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "jsdom": "^29.0.2",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    }
}
